---
import Section from "./Section.astro";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  {
    projects.map(
      (
        { name, summary, technologies, image, linkPreview, linkSource },
        index,
      ) => {
        const top = 98 + index * 40;
        return (
          <div
            style={`top: ${top}px;`}
            class="mb-12 rounded-2xl border border-neutral/20 bg-black md:sticky"
          >
            <div class="bg-difu relative z-[1] grid min-h-[680px] w-full grid-rows-[auto_20rem] rounded-2xl bg-[#1c232d]/85 before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-[length:128px] before:bg-repeat before:opacity-[5%] before:content-[''] sm:h-[560px] sm:min-h-0 sm:grid-cols-2 sm:grid-rows-1 md:h-[480px]">
              <div class="px-6 py-10 md:py-12">
                <h3 class="mb-5 font-serif text-3xl font-medium text-primary">
                  {name}
                </h3>
                <p class="text-base text-neutral">{summary}</p>
                <ul
                  class="mt-5 flex flex-wrap gap-2"
                  aria-label={`${name} technologies`}
                >
                  {technologies.map((technology) => (
                    <li class="rounded-full border border-neutral/30 bg-white/5 px-2.5 py-1 text-xs text-white">
                      {technology}
                    </li>
                  ))}
                </ul>
                <div class="flex gap-5 pt-7 text-white">
                  {linkSource && (
                    <a
                      href={linkSource}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`View ${name} code on GitHub (opens in a new tab)`}
                      class="after:relative after:bottom-[-5px] after:content-[url(/external.svg)] hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                    >
                      View Code
                    </a>
                  )}
                  {linkPreview && (
                    <a
                      href={linkPreview}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Preview ${name} (opens in a new tab)`}
                      class="after:relative after:bottom-[-5px] after:content-[url(/external.svg)] hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                    >
                      Preview
                    </a>
                  )}
                </div>
              </div>
              <div class="flex items-end justify-center overflow-hidden rounded-ss-xl rounded-ee-2xl">
                <img
                  class="h-full w-full rounded-ss-xl rounded-ee-2xl object-cover object-center sm:h-[85%]"
                  src={image}
                  alt={name}
                  width="736"
                  height="483"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        );
      },
    )
  }
</Section>
